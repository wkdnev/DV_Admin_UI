@* Page disabled — credential management is now on /sysadmin/users *@
@* @page "/sysadmin/credentials" *@
@attribute [Authorize(Policy = "GlobalAdminOnly")]
@using DV.Shared.Interfaces
@inject UserService UserService
@inject ICredentialService CredentialService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Local Credential Management</PageTitle>

<div class="lgreeny-dashboard">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <div>
            <h2 style="margin: 0; color: #1e293b; font-size: 1.75rem; font-weight: 600;">🔐 Local Credential Management</h2>
            <p style="margin: 0.5rem 0 0 0; color: #64748b; font-size: 0.875rem;">Manage username/password authentication for non-SSO users (NIST SP 800-53 Rev 5)</p>
        </div>
        <div style="display: flex; gap: 0.75rem;">
            <button class="lgreeny-btn-primary" style="width: auto;" @onclick="OpenCreateDialog">
                ➕ Create Credentials
            </button>
            <button class="lgreeny-btn-secondary" style="width: auto;" @onclick="GoBackToDashboard">
                ← Back to Dashboard
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div style="text-align: center; padding: 2rem;">
            <div style="color: #3b82f6; font-size: 1.5rem;">⏳</div>
            <p style="color: #64748b; margin-top: 0.5rem;">Loading credentials...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="padding: 1rem; background: #fee2e2; border: 1px solid #fecaca; border-radius: 0.5rem; margin-bottom: 1.5rem; color: #991b1b;">
            ⚠️ @errorMessage
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div style="padding: 1rem; background: #d1fae5; border: 1px solid #a7f3d0; border-radius: 0.5rem; margin-bottom: 1.5rem; color: #065f46;">
                ✅ @successMessage
            </div>
        }

        <!-- NIST Info Box -->
        <div style="padding: 1rem; background: #dbeafe; border: 1px solid #bfdbfe; border-radius: 0.5rem; margin-bottom: 1.5rem; color: #1e40af;">
            <h6 style="margin: 0 0 0.5rem 0; font-weight: 600;">🛡️ NIST SP 800-53 Rev 5 Compliance</h6>
            <p style="margin: 0; font-size: 0.875rem;">
                Passwords are hashed with <strong>PBKDF2-SHA512</strong> (600,000 iterations, 128-bit salt).
                Accounts lock after <strong>5 failed attempts</strong> for <strong>15 minutes</strong> (AC-7).
                Users must change admin-assigned passwords on first login (IA-5).
                Minimum <strong>12 characters</strong>, no arbitrary composition rules (SP 800-63B).
            </p>
        </div>

        <!-- Users with Local Credentials -->
        <div class="lgreeny-panel" style="margin-bottom: 1.5rem;">
            <div class="panel-header">
                <h3 class="panel-title">Users with Local Credentials (@credentialUsers.Count)</h3>
            </div>
            <div class="panel-body">
                @if (credentialUsers.Count == 0)
                {
                    <div style="padding: 1rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.5rem; color: #64748b;">
                        ℹ️ No users have local credentials configured. Use the "Create Credentials" button to set up password authentication for a user.
                    </div>
                }
                else
                {
                    <table class="lgreeny-table">
                        <thead>
                            <tr>
                                <th>USERNAME</th>
                                <th>DISPLAY NAME</th>
                                <th>STATUS</th>
                                <th>LAST LOGIN</th>
                                <th>PASSWORD CHANGED</th>
                                <th>MUST CHANGE</th>
                                <th>ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in credentialUsers)
                            {
                                <tr>
                                    <td style="font-weight: 600;">@item.User.Username</td>
                                    <td>@(item.User.DisplayName ?? "—")</td>
                                    <td>
                                        @if (item.Credential.IsLockedOut)
                                        {
                                            <span style="background: #fee2e2; color: #991b1b; padding: 0.25rem 0.625rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: 600;">🔒 LOCKED</span>
                                        }
                                        else if (!item.User.IsActive)
                                        {
                                            <span style="background: #f3f4f6; color: #6b7280; padding: 0.25rem 0.625rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: 600;">INACTIVE</span>
                                        }
                                        else
                                        {
                                            <span style="background: #d1fae5; color: #065f46; padding: 0.25rem 0.625rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: 600;">✓ ACTIVE</span>
                                        }
                                    </td>
                                    <td style="font-size: 0.875rem; color: #64748b;">@(item.Credential.LastSuccessfulLoginAt?.ToString("dd MMM yyyy HH:mm") ?? "Never")</td>
                                    <td style="font-size: 0.875rem; color: #64748b;">@(item.Credential.PasswordChangedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                                    <td>
                                        @if (item.Credential.MustChangePassword)
                                        {
                                            <span style="background: #fef3c7; color: #92400e; padding: 0.25rem 0.625rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: 600;">YES</span>
                                        }
                                        else
                                        {
                                            <span style="color: #64748b; font-size: 0.875rem;">No</span>
                                        }
                                    </td>
                                    <td>
                                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                            <button class="lgreeny-btn-secondary" style="width: auto; padding: 0.25rem 0.625rem; font-size: 0.75rem;"
                                                    @onclick="() => OpenResetPasswordDialog(item.User)">
                                                🔑 Reset Password
                                            </button>
                                            @if (item.Credential.IsLockedOut)
                                            {
                                                <button class="lgreeny-btn-primary" style="width: auto; padding: 0.25rem 0.625rem; font-size: 0.75rem;"
                                                        @onclick="() => UnlockAccount(item.User)">
                                                    🔓 Unlock
                                                </button>
                                            }
                                            <button style="background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; border-radius: 0.375rem; padding: 0.25rem 0.625rem; font-size: 0.75rem; cursor: pointer;"
                                                    @onclick="() => RemoveCredentials(item.User)">
                                                🗑️ Remove
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }

    <!-- Create Credentials Dialog -->
    @if (showCreateDialog)
    {
        <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;">
            <div style="background: white; border-radius: 0.75rem; padding: 2rem; width: 100%; max-width: 500px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);">
                <h3 style="margin: 0 0 1rem 0; color: #1e293b; font-size: 1.25rem; font-weight: 600;">🔐 Create Local Credentials</h3>

                @if (!string.IsNullOrEmpty(dialogError))
                {
                    <div style="padding: 0.75rem; background: #fee2e2; border: 1px solid #fecaca; border-radius: 0.5rem; margin-bottom: 1rem; color: #991b1b; font-size: 0.875rem;">
                        @dialogError
                    </div>
                }

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 500; margin-bottom: 0.25rem; color: #374151; font-size: 0.875rem;">Select User</label>
                    <select @bind="selectedUserId" style="width: 100%; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 0.375rem; font-size: 0.875rem;">
                        <option value="0">— Select a user —</option>
                        @foreach (var user in usersWithoutCredentials)
                        {
                            <option value="@user.UserId">@user.Username (@(user.DisplayName ?? "No display name"))</option>
                        }
                    </select>
                </div>

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 500; margin-bottom: 0.25rem; color: #374151; font-size: 0.875rem;">Initial Password</label>
                    <input type="password" @bind="newPassword" style="width: 100%; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 0.375rem; font-size: 0.875rem;" placeholder="Minimum 12 characters" />
                    <p style="margin: 0.25rem 0 0 0; font-size: 0.75rem; color: #6b7280;">User will be required to change this on first login.</p>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <label style="display: block; font-weight: 500; margin-bottom: 0.25rem; color: #374151; font-size: 0.875rem;">Confirm Password</label>
                    <input type="password" @bind="confirmPassword" style="width: 100%; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 0.375rem; font-size: 0.875rem;" placeholder="Confirm password" />
                </div>

                <div style="display: flex; gap: 0.75rem; justify-content: flex-end;">
                    <button class="lgreeny-btn-secondary" style="width: auto;" @onclick="CloseDialogs">Cancel</button>
                    <button class="lgreeny-btn-primary" style="width: auto;" @onclick="CreateCredentials" disabled="@isProcessing">
                        @(isProcessing ? "Creating..." : "Create Credentials")
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Reset Password Dialog -->
    @if (showResetDialog)
    {
        <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;">
            <div style="background: white; border-radius: 0.75rem; padding: 2rem; width: 100%; max-width: 500px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);">
                <h3 style="margin: 0 0 1rem 0; color: #1e293b; font-size: 1.25rem; font-weight: 600;">🔑 Reset Password</h3>
                <p style="margin: 0 0 1rem 0; color: #64748b; font-size: 0.875rem;">
                    Resetting password for <strong>@resetTargetUser?.Username</strong>. User will be required to change this on next login.
                </p>

                @if (!string.IsNullOrEmpty(dialogError))
                {
                    <div style="padding: 0.75rem; background: #fee2e2; border: 1px solid #fecaca; border-radius: 0.5rem; margin-bottom: 1rem; color: #991b1b; font-size: 0.875rem;">
                        @dialogError
                    </div>
                }

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 500; margin-bottom: 0.25rem; color: #374151; font-size: 0.875rem;">New Password</label>
                    <input type="password" @bind="newPassword" style="width: 100%; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 0.375rem; font-size: 0.875rem;" placeholder="Minimum 12 characters" />
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <label style="display: block; font-weight: 500; margin-bottom: 0.25rem; color: #374151; font-size: 0.875rem;">Confirm Password</label>
                    <input type="password" @bind="confirmPassword" style="width: 100%; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 0.375rem; font-size: 0.875rem;" placeholder="Confirm password" />
                </div>

                <div style="display: flex; gap: 0.75rem; justify-content: flex-end;">
                    <button class="lgreeny-btn-secondary" style="width: auto;" @onclick="CloseDialogs">Cancel</button>
                    <button class="lgreeny-btn-primary" style="width: auto;" @onclick="ResetPassword" disabled="@isProcessing">
                        @(isProcessing ? "Resetting..." : "Reset Password")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isProcessing;
    private string? errorMessage;
    private string? successMessage;
    private string? dialogError;

    private List<CredentialUserInfo> credentialUsers = new();
    private List<ApplicationUser> usersWithoutCredentials = new();

    // Create dialog
    private bool showCreateDialog;
    private int selectedUserId;
    private string newPassword = "";
    private string confirmPassword = "";

    // Reset dialog
    private bool showResetDialog;
    private ApplicationUser? resetTargetUser;

    // Current admin username
    private string currentAdminUsername = "System";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Get current admin username from auth state
            var authState = await GetAuthenticationState();
            currentAdminUsername = authState ?? "System";

            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load credential data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadData()
    {
        var allUsers = await UserService.GetAllUsersAsync();
        credentialUsers.Clear();
        usersWithoutCredentials.Clear();

        foreach (var user in allUsers)
        {
            var credential = await CredentialService.GetCredentialInfoAsync(user.UserId);
            if (credential != null)
            {
                credentialUsers.Add(new CredentialUserInfo { User = user, Credential = credential });
            }
            else
            {
                usersWithoutCredentials.Add(user);
            }
        }

        // Sort: locked first, then by username
        credentialUsers = credentialUsers
            .OrderByDescending(c => c.Credential.IsLockedOut)
            .ThenBy(c => c.User.Username)
            .ToList();

        usersWithoutCredentials = usersWithoutCredentials.OrderBy(u => u.Username).ToList();
    }

    private void OpenCreateDialog()
    {
        showCreateDialog = true;
        selectedUserId = 0;
        newPassword = "";
        confirmPassword = "";
        dialogError = null;
        successMessage = null;
    }

    private void OpenResetPasswordDialog(ApplicationUser user)
    {
        showResetDialog = true;
        resetTargetUser = user;
        newPassword = "";
        confirmPassword = "";
        dialogError = null;
        successMessage = null;
    }

    private void CloseDialogs()
    {
        showCreateDialog = false;
        showResetDialog = false;
        dialogError = null;
        newPassword = "";
        confirmPassword = "";
    }

    private async Task CreateCredentials()
    {
        dialogError = null;

        if (selectedUserId == 0)
        {
            dialogError = "Please select a user.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            dialogError = "Password is required.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            dialogError = "Passwords do not match.";
            return;
        }

        isProcessing = true;
        try
        {
            var error = await CredentialService.CreateCredentialAsync(selectedUserId, newPassword, currentAdminUsername);
            if (error != null)
            {
                dialogError = error;
                return;
            }

            var user = usersWithoutCredentials.FirstOrDefault(u => u.UserId == selectedUserId);
            successMessage = $"Local credentials created for {user?.Username ?? "user"}. They will be prompted to change their password on first login.";

            CloseDialogs();
            await LoadData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            dialogError = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ResetPassword()
    {
        dialogError = null;

        if (resetTargetUser == null) return;

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            dialogError = "Password is required.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            dialogError = "Passwords do not match.";
            return;
        }

        isProcessing = true;
        try
        {
            var error = await CredentialService.AdminResetPasswordAsync(resetTargetUser.UserId, newPassword, currentAdminUsername);
            if (error != null)
            {
                dialogError = error;
                return;
            }

            successMessage = $"Password reset for {resetTargetUser.Username}. They will be prompted to change it on next login.";

            CloseDialogs();
            await LoadData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            dialogError = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task UnlockAccount(ApplicationUser user)
    {
        try
        {
            await CredentialService.UnlockAccountAsync(user.UserId);
            successMessage = $"Account unlocked for {user.Username}.";
            await LoadData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to unlock account: {ex.Message}";
        }
    }

    private async Task RemoveCredentials(ApplicationUser user)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Remove local credentials for {user.Username}? They will only be able to sign in via SSO.");
        if (!confirmed) return;

        try
        {
            await CredentialService.RemoveCredentialAsync(user.UserId);
            successMessage = $"Local credentials removed for {user.Username}.";
            await LoadData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to remove credentials: {ex.Message}";
        }
    }

    private void GoBackToDashboard()
    {
        Navigation.NavigateTo("/sysadmin/");
    }

    private async Task<string?> GetAuthenticationState()
    {
        try
        {
            // Access the HttpContext to get the current user
            // In Blazor Server, we need to use cascading auth state
            return null; // Will be set from cascading parameter
        }
        catch
        {
            return null;
        }
    }

    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationState != null)
        {
            var authState = await AuthenticationState;
            currentAdminUsername = authState.User.Identity?.Name ?? "System";
        }
    }

    private class CredentialUserInfo
    {
        public ApplicationUser User { get; set; } = null!;
        public UserCredential Credential { get; set; } = null!;
    }
}
